    <string name="almost_ready">כמעט מוכנים.</string>
    <string name="permissions_screen_description">כדי להוציא אותך מהמיטה, QRAlarm זקוק לכמה הרשאות. משתמשים בהן רק כדי לוודא שהשעון המעורר תמיד יפעל.</string>
    <string name="background_work">עבודה ברקע</string>
    <string name="thousands_of_mornings_changed">אלפי בקרים השתנו.</string>
    <string name="verified_user">משתמש מאומת</string>
    <string name="review_1">שינה לי את החיים! בזכות האפליקציה אני מגיע בזמן, בכל פעם! שמתי את קוד ה־QR בחדר אחר, כך שצריך לצאת מהמיטה כדי לכבות את השעון המעורר. זה עובד נפלא!</string>
    <string name="review_2">פתרון פשוט ויעיל למי שנוטים לישון דרך השעון המעורר. הבקרים כבר לא מתחילים במרוץ לחוץ, ויש לי מספיק זמן ליהנות ממקלחת בוקר ומארוחת בוקר, ועדיין להגיע לעבודה מוקדם. חמישה כוכבים לא מספיקים — האפליקציה הזאת משנה את כללי המשחק ושווה הרבה יותר מהזמן, הכסף והמאמץ שהשקעתי בה.</string>
    <string name="review_3">פשוטה אבל יעילה — אי אפשר להישאר במיטה כשהשעון המעורר מצלצל. במקום להגדיר 20 שעונים מעוררים בהפרש של 5 דקות ולכבות אותם מתוך שינה, האפליקציה מכריחה אותי לקום מהמיטה ולסרוק ברקוד בחדר אחר.</string>
    <string name="review_4">השעון המעורר הזה הציל לי את העבודה, ואולי גם את החיים. פשוט אין דרך אחרת להוציא אותי מהמיטה חוץ מסריקת קוד QR כדי לכבות את השעון המעורר. הגוף שלי כבר התרגל כל כך לכבות את השעון מתוך שינה, שהייתי מתעורר בלי לדעת שהוא בכלל צלצל. השעון הזה מונע ממני לאחר לעבודה, ואני אסיר תודה!</string>
    <string name="review_5">אפליקציה מצוינת עם עדכונים קבועים שמוסיפים המון תכונות חדשות! היא קלה מאוד לשימוש וחוסכת לי המון זמן.</string>
